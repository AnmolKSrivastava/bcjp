# Non-secret config for Cloud Functions + local API.
# API keys go in functions/.env.local (gitignored) — never commit them, never use VITE_*.
#
# Firebase Secret Manager (production):
#   firebase functions:secrets:set OPENAI_API_KEY
#   firebase functions:secrets:set GOOGLE_TTS_API_KEY
#
# Local only — create functions/.env.local with:
#   OPENAI_API_KEY=sk-...
#   GOOGLE_TTS_API_KEY=...
#   LOCAL_API_PORT=8787

OPENAI_MODEL=gpt-4o-mini
GOOGLE_TTS_SPEAKING_RATE=0.85

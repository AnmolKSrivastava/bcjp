rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isEmployer() {
      return isSignedIn() && userDoc().role == 'employer';
    }

    function isAdmin() {
      return isSignedIn() && userDoc().role == 'admin';
    }

    function belongsToOrg(orgId) {
      return isSignedIn() && userDoc().organizationId == orgId;
    }

    // ---- users/ ----
    // Owner manages own doc; platform admins can list/read all users.
    // Admin role cannot be self-assigned via client create/update.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.role in ['worker', 'employer']
        && request.resource.data.phone == request.auth.token.phone_number;
      allow update: if (isOwner(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.phone == resource.data.phone)
        || (isAdmin()
          && request.resource.data.role == resource.data.role
          && request.resource.data.phone == resource.data.phone);
      allow delete: if false;
    }

    // ---- organizations/ ----
    match /organizations/{orgId} {
      allow read: if isSignedIn();
      allow create: if isEmployer()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if (isEmployer() && belongsToOrg(orgId)) || isAdmin();
      allow delete: if false;
    }

    // ---- jobOpenings/ ----
    match /jobOpenings/{jobId} {
      allow read: if resource.data.status == 'open' || isSignedIn();
      allow create: if isEmployer()
        && belongsToOrg(request.resource.data.organizationId);
      allow update: if (isEmployer()
          && belongsToOrg(resource.data.organizationId)
          && request.resource.data.organizationId == resource.data.organizationId)
        || (isAdmin()
          && request.resource.data.organizationId == resource.data.organizationId);
      allow delete: if false;
    }

    // ---- applications/ ----
    match /applications/{applicationId} {
      allow create: if isSignedIn()
        && request.resource.data.candidateId == request.auth.uid;
      allow read: if isSignedIn()
        && (resource.data.candidateId == request.auth.uid
          || belongsToOrg(resource.data.organizationId)
          || isAdmin());
      allow update: if (isEmployer()
          && belongsToOrg(resource.data.organizationId)
          && request.resource.data.candidateId == resource.data.candidateId
          && request.resource.data.organizationId == resource.data.organizationId)
        || isAdmin();
      allow delete: if false;
    }

    // ---- candidates/ ----
    match /candidates/{uid} {
      allow read: if isOwner(uid) || isEmployer() || isAdmin();
      allow create, update: if isOwner(uid) && userDoc().role == 'worker';
      allow delete: if false;
    }

    // ---- savedJobs/ ----
    match /savedJobs/{savedId} {
      allow read: if isSignedIn()
        && (resource.data.candidateId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.candidateId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.candidateId == request.auth.uid;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

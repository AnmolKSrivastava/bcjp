VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Secrets must NOT go here. Put them in functions/.env (see functions/.env.example).
#   OPENAI_API_KEY      → parse interview answers into form fields
#   GOOGLE_TTS_API_KEY  → Google Cloud Text-to-Speech for interview voice
# Local APIs are proxied by Vite to http://localhost:8787
#   /api/voice-profile
#   /api/voice-tts
# VITE_VOICE_PROFILE_API_URL=/api/voice-profile
# VITE_VOICE_TTS_API_URL=/api/voice-tts
